// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// stage is a plain String because SQLite has no native enum type.
// Valid values are enforced in application code — see src/lib/stages.ts.
model Prospect {
  id               Int      @id @default(autoincrement())
  companyName      String   @map("company_name")
  sector           String
  originCountry    String   @map("origin_country")
  targetMarket     String   @map("target_market")
  contactName      String?  @map("contact_name")
  contactEmail     String?  @map("contact_email")
  contactRole      String?  @map("contact_role")
  source           String?
  stage            String   @default("Sourced")
  nextFollowUpDate DateTime? @map("next_follow_up_date")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("prospects")
}
